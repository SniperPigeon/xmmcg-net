[Unit]
Description=XMMCG API
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/xmmcg/backend/xmmcg
EnvironmentFile=/opt/xmmcg/.env
RuntimeDirectory=gunicorn
ExecStart=/opt/xmmcg/.venv/bin/gunicorn xmmcg.wsgi:application --bind unix:/run/gunicorn/xmmcg.sock --workers 2 --timeout 300 --access-logfile - --error-logfile -
Restart=on-failure

[Install]
WantedBy=multi-user.target

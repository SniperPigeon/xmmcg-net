# Django 基础配置
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,xmmcg.majdata.net
# 生产与开发均使用 SQLite，省略时为后端目录下的 db.sqlite3。
# SQLITE_PATH=/opt/xmmcg/backend/xmmcg/db.sqlite3
TIME_ZONE=Asia/Shanghai
PRODUCTION_DOMAIN=xmmcg.majdata.net
FRONTEND_ORIGINS=https://xmmcg.majdata.net,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://xmmcg.majdata.net,http://localhost:5173
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# 仅在前端和 API 不同站点时设为 None，此时必须使用 HTTPS。
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# R2 S3 凭证仅供后端使用，不能放入 VITE_ 开头的前端变量。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# 可选：指定完整的 S3 端点。
R2_ENDPOINT_URL=
# 可选：公开资源自定义域名。留空时使用私有桶和临时签名读取地址。
R2_PUBLIC_DOMAIN=
R2_URL_EXPIRY=3600
R2_CORS_ORIGINS=https://xmmcg.majdata.net,http://localhost:5173

# 联调时使用进程环境变量 ENABLE_CHART_FORWARD_TO_MAJDATA=False 禁用真实上传。
ENABLE_CHART_FORWARD_TO_MAJDATA=True
MAJDATA_USERNAME=
MAJDATA_PASSWD_HASHED=
MAJDATA_LOGIN_URL=https://majdata.net/api3/api/account/Login
MAJDATA_UPLOAD_URL=https://majdata.net/api3/api/maichart/upload
# 保留原上传大小与歌曲数量的默认限制。
MAX_AUDIO_SIZE_MB=10
MAX_COVER_SIZE_MB=2
MAX_VIDEO_SIZE_MB=20
MAX_CHART_SIZE_MB=1
MAX_SONGS_PER_USER=3

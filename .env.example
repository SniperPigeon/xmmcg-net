SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,xmmcg.example.com
# Production: use a managed PostgreSQL database. SQLite remains available for development.
# DATABASE_URL=postgresql://user:password@host:5432/xmmcg?sslmode=require
TIME_ZONE=Asia/Shanghai
FRONTEND_ORIGINS=https://xmmcg.example.com,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://xmmcg.example.com,http://localhost:5173
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# Set both to None only for a frontend on a different site; HTTPS is required.
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# R2 S3 credentials, available only to the backend (never use VITE_ for secrets).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional override, e.g. a jurisdiction-specific endpoint.
R2_ENDPOINT_URL=
# Optional public custom domain. Blank = private bucket with signed GET URLs.
R2_PUBLIC_DOMAIN=
R2_URL_EXPIRY=3600
R2_CORS_ORIGINS=https://xmmcg.example.com,http://localhost:5173

ENABLE_CHART_FORWARD_TO_MAJDATA=True
MAJDATA_USERNAME=
MAJDATA_PASSWD_HASHED=
MAJDATA_LOGIN_URL=https://majdata.net/api3/api/account/Login
MAJDATA_UPLOAD_URL=https://majdata.net/api3/api/maichart/upload
MAX_AUDIO_SIZE_MB=50
MAX_COVER_SIZE_MB=10
MAX_VIDEO_SIZE_MB=200
MAX_CHART_SIZE_MB=5
